# Broadcast masters and replay captures. These are derived data — regenerate
# them from the archived transcript with engine/record_cw.py (Core War) or a
# `ctl replay` capture (chess/xiangqi). They run to hundreds of megabytes.
*.mp4
*.mov
*.m4a
*.wav
*.gif
!docs/assets/*.gif

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Recorder scratch
cw-record-*/
frames/

# OS
.DS_Store

# Live runtime (ephemeral — archived into games/ on completion)
.ai-agent-arcade/
tasks/

# Archived matches (reproducible via `uvx ai-agent-arcade --games N`)
# Keep curated fixtures: match-009 (README verify + GIF) and match-171
# (MISTRAL×MUSE-SPARK showcase). Others are local cache.
# Note: ignore contents, not the dir itself, so ! can re-include fixtures.
games/chess/match-*/
!games/chess/match-009/
!games/chess/match-171/
!games/chess/match-009/**
!games/chess/match-171/**
